{
  "version": 8,
  "name": "OSM Liberty",
  "metadata": {
    "maputnik:license": "https://github.com/maputnik/osm-liberty/blob/gh-pages/LICENSE.md",
    "maputnik:renderer": "ol",
    "openmaptiles:version": "3.x"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key={key}"
    }
  },
  "sprite": "../data/json/osm_liberty_sprite",
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key={key}",
  "layers": [
    {
      "id": "road_outline1",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "五级道路_14",
      "paint": {
        "line-color": "rgba(0, 255, 0, 1)",
        "line-width": 1
      }
    },
    {
      "id": "road_outline2",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "乡镇村道_15",
      "paint": {
        "line-color": "rgba(255, 0, 0, 1)"
      }
    },
    {
      "id": "road_outline3",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "乡镇村道_15",
      "filter": ["==", "NAME", "振兴路"],
      "paint": {
        "line-color": "rgba(0, 255, 255, 1)"
      }
    },
    {
      "id": "road_outline4",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "海岸线100万_28",
      "paint": {
        "line-color": "rgba(0, 0, 255, 1)"
      }
    },
    {
      "id": "island_outline4",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "岛屿100万_48",
      "paint": {
        "fill-color": {
          "base": 1,
          "stops": [
            [9, "hsla(0, 3%, 85%, 0.84)"],
            [12, "hsla(35, 57%, 88%, 0.49)"]
          ]
        }
      }
    },
    {
      "id": "mountain_outline4",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "山峰_2",
      "layout": {
        "icon-image": "arrow",
        "text-field": "{NAME}",
        "text-font": ["Roboto Regular"],
        "text-max-width": 5,
        "text-size": 10,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#666",
        "text-halo-blur": 0.5,
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ],
  "id": "osm-liberty"
}