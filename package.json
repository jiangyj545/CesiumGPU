{
  "name": "cesiumgpu",
  "version": "0.1.0",
  "description": "A Cesium-like WebGPU 3D rendering engine",
  "main": "src/index.ts",
  "module": "dist-lib/cesiumgpu.es.js",
  "types": "dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/cesiumgpu.es.js",
      "require": "./dist-lib/cesiumgpu.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:api": "typedoc",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@webgpu/types": "^0.1.69",
    "eslint": "^8.57.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "webgpu",
    "cesium",
    "3d",
    "rendering",
    "earth"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
